# =============================================================================
#  Anatomy Bot — переменные окружения
#
#  Скопируйте в .env и заполните.  .env НЕ коммитится в репозиторий (см. .gitignore).
#
#  ВСЕ СЕКРЕТЫ ПРОЕКТА ЖИВУТ ТОЛЬКО ЗДЕСЬ. Их шесть штук, они помечены
#  ниже пометкой [СЕКРЕТ]. Где брать каждый — написано в README, раздел
#  «Где взять токены и ключи».
# =============================================================================

# ---------- Общее ----------
PROJECT_NAME=Anatomy Bot
ENVIRONMENT=development           # development | production
LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR
# Публичный домен — нужен только в проде, для выпуска TLS-сертификата
PUBLIC_DOMAIN=anatomy-bot.example.ru
ACME_EMAIL=admin@example.ru

# ---------- Порты на хосте ----------
# Меняйте, если порт уже занят другой программой. Внутри Docker сервисы
# общаются по именам, эти значения на связь между контейнерами не влияют.
# Проверить занятость в Windows:  netstat -ano | findstr :5432
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
API_HOST_PORT=8080
WEB_HOST_PORT=5173
EMBEDDINGS_HOST_PORT=8100
OLLAMA_HOST_PORT=11434

# ---------- Postgres ----------
POSTGRES_USER=anatomy
# [СЕКРЕТ 1] Пароль БД. Придумайте сами: openssl rand -base64 24
POSTGRES_PASSWORD=change_me_please
POSTGRES_DB=anatomy
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ---------- Redis ----------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# ---------- Безопасность админ-панели ----------
# [СЕКРЕТ 2] Ключ подписи JWT. Сгенерируйте: openssl rand -hex 32
# При смене все выданные токены входа перестают действовать.
SECRET_KEY=change_me_generate_with_openssl_rand_hex_32
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Первый администратор создаётся автоматически при первом запуске
FIRST_ADMIN_EMAIL=admin@example.ru
# [СЕКРЕТ 3] Пароль первого входа. Смените его в панели сразу после входа.
FIRST_ADMIN_PASSWORD=change_me_admin_password

# Откуда разрешены запросы к API. В проде — ваш реальный домен через https.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# =============================================================================
#  ЯЗЫКОВАЯ МОДЕЛЬ
# =============================================================================

# Доступны два провайдера:
#   ollama   — локальная модель на своём железе (быстро с GPU, медленнее без)
#   gigachat — облачный резерв
# Переключаются здесь или прямо из админки: Параметры → Модель → Провайдер.

# ---------- Основной провайдер: Ollama ----------
# После первого запуска скачайте модель:
#   docker compose exec ollama ollama pull qwen3:8b
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:8b
LLM_BASE_URL=http://ollama:11434/v1
# Если модель крутится на другой машине, укажите её адрес: протокол тот же.
# Локальной модели ключ не нужен, значение игнорируется
LLM_API_KEY=not-needed-for-local
LLM_TIMEOUT_SECONDS=180

# ---------- Резервный провайдер: GigaChat ----------
# Включается, когда локальная модель недоступна. Можно также выбрать
# GigaChat основным прямо из админ-панели, в разделе «Параметры».
LLM_FALLBACK_ENABLED=false
LLM_FALLBACK_PROVIDER=gigachat
LLM_FALLBACK_MODEL=GigaChat-2

# [СЕКРЕТ 4] Ключ авторизации GigaChat.
# Это ОДНА строка в base64 из личного кабинета (поле «Авторизационные данные»),
# а не пара логин-пароль. Выглядит примерно так:
#   NDdiZTIxYzUtMWI4NC00OWM4LWJiMTYtM2Y4NDNjMjIzNTFhOmE5...
GIGACHAT_AUTH_KEY=

# Если у вас на руках только Client ID и Client Secret по отдельности,
# заполните эти два поля вместо GIGACHAT_AUTH_KEY — ключ соберётся сам.
GIGACHAT_CLIENT_ID=
GIGACHAT_CLIENT_SECRET=

# GIGACHAT_API_PERS — физлица, GIGACHAT_API_B2B — ИП и юрлица по предоплате,
# GIGACHAT_API_CORP — корпоративный доступ
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# GigaChat-2 | GigaChat-2-Pro | GigaChat-2-Max
GIGACHAT_MODEL=GigaChat-2

# Сертификат GigaChat подписан НУЦ Минцифры, которого нет в стандартном
# образе Linux. Варианты:
#   false                     — не проверять сертификат (быстрый старт)
#   /certs/russian_trusted.pem — проверять по сертификату НУЦ
# Чтобы включить проверку, запустите deploy/install-russian-ca.sh
GIGACHAT_VERIFY_SSL=false

# =============================================================================
#  ЭМБЕДДИНГИ (отдельный контейнер, работает на CPU)
# =============================================================================
EMBEDDINGS_BASE_URL=http://embeddings:8100
EMBEDDING_MODEL=BAAI/bge-m3
# ВНИМАНИЕ: размерность зашита в миграцию 0001. Смена модели эмбеддингов на
# модель с другой размерностью требует новой миграции и переиндексации всех
# документов и изображений.
EMBEDDING_DIM=1024
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# cpu | cuda — держим на cpu, чтобы не отнимать VRAM у языковой модели
EMBEDDINGS_DEVICE=cpu

# =============================================================================
#  ВКОНТАКТЕ
# =============================================================================
VK_ENABLED=false
# [СЕКРЕТ 5] Ключ доступа сообщества VK.
# Управление сообществом → Работа с API → Ключи доступа → Создать ключ.
# Начинается с vk1.a....  Права: «Сообщения сообщества».
VK_GROUP_TOKEN=
# Числовой ID сообщества, без минуса. Виден там же, в адресе или через
# Управление → Адрес страницы.
VK_GROUP_ID=
VK_RATE_LIMIT_PER_MINUTE=10

# =============================================================================
#  ХРАНИЛИЩЕ ФАЙЛОВ
# =============================================================================
STORAGE_DIR=/data/storage
MAX_UPLOAD_SIZE_MB=200

# =============================================================================
#  ФРОНТЕНД (используется на этапе сборки)
# =============================================================================
VITE_API_BASE_URL=/api/v1
