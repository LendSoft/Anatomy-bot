# окружение — содержит пароли и токены, в репозиторий не попадает
.env
.env.local
.env.*.local

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.venv-check/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Node
node_modules/
dist/
.vite/
npm-debug.log*

# данные и загруженные материалы
/data/
storage/
# учебники для проверки разбора: сотни мегабайт и чужие авторские права
/docx/

